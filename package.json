{
  "name": "tienda-modular",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "npm run db:seed:build && wrangler d1 execute DB --local --file=db/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "npm run db:seed:build && wrangler d1 execute DB --remote --file=db/seed.sql",
    "db:seed:build": "node scripts/build-seed.ts",
    "deploy:artelicat": "astro build && wrangler deploy",
    "deploy:pochi": "CLOUDFLARE_ENV=pochi astro build && wrangler deploy",
    "deploy": "npm run db:migrate:remote && npm run deploy:artelicat && npm run deploy:pochi"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "astro": "^7.4.2",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0"
  }
}
