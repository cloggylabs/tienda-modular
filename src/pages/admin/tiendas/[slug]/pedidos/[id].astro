---
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Errors from '../../../../../components/admin/Errors.astro';
import { getDb } from '../../../../../lib/db';
import { getStoreBySlug, storeLinker } from '../../../../../modules/tiendas/repo';
import { getOrder, listOrderEvents, listOrderItems, updateOrder } from '../../../../../modules/pedidos/repo';
import { availableUnits, formatCOP } from '../../../../../modules/catalogo/format';
import { listProductsByIds } from '../../../../../modules/catalogo/repo';
import { CARRIER_MAX, TRACKING_MAX, parseShippingForm, type ShippingValues } from '../../../../../modules/pedidos/validate';
import {
  CARRIERS,
  ORDER_STATUS_LABELS,
  PAYMENT_STATUS_LABELS,
  customerChatUrl,
  customerUpdateMessage,
  formatDateTime,
  formatPhone,
  orderActions,
  orderCode,
  orderTimeline,
  paymentMethodLabel,
  shippingLabel,
} from '../../../../../modules/pedidos/format';
import { checkoutConfig } from '../../../../../modules/tiendas/settings';

const db = getDb();
const store = await getStoreBySlug(db, Astro.params.slug!);
if (!store) return new Response(null, { status: 404 });
const id = Number(Astro.params.id);
const order = Number.isInteger(id) && id > 0 ? await getOrder(db, store.id, id) : undefined;
if (!order) return Astro.rewrite('/404');
const base = `/admin/tiendas/${store.slug}/pedidos`;
const self = `${base}/${order.id}`;
const actions = orderActions(order);

const MESSAGES: Record<string, string> = {
  confirm_payment: 'Pago confirmado. El pedido quedó confirmado.',
  reject_receipt: 'Comprobante rechazado. La clienta puede subir otro desde el enlace de su pedido.',
  confirm_order: 'Pedido confirmado.',
  prepare: 'Pedido en preparación.',
  ship: 'Pedido marcado en camino.',
  deliver: 'Pedido entregado.',
  cancel: 'Pedido cancelado.',
  reopen: 'Pedido reabierto.',
  note: 'Nota guardada.',
  shipping: 'Datos del envío guardados.',
};
/** Acciones que cambian lo que ve la clienta: después de ellas se ofrece avisarle por WhatsApp. */
const NOTIFY_AFTER = new Set(['confirm_payment', 'reject_receipt', 'confirm_order', 'prepare', 'ship', 'deliver', 'cancel', 'shipping']);

let errors: string[] = [];
let shipping: ShippingValues = { carrier: order.carrier, trackingNumber: order.trackingNumber };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'note') {
    await updateOrder(db, order, { adminNote: String(form.get('adminNote') ?? '').trim().slice(0, 2000) });
    return Astro.redirect(`${self}?ok=note`);
  }
  // Transportadora y guía: se piden al marcar «En camino» y se pueden corregir después.
  const editShipping = action === 'shipping' && (order.status === 'shipped' || order.status === 'delivered');
  const chosen = actions.find((a) => a.action === action);
  if (editShipping || chosen?.action === 'ship') {
    const parsed = parseShippingForm(form);
    shipping = parsed.values;
    errors = parsed.errors;
    if (!errors.length) {
      await updateOrder(db, order, editShipping ? shipping : { ...chosen!.patch, ...shipping });
      return Astro.redirect(`${self}?ok=${action}`);
    }
  } else if (chosen) {
    // Solo las acciones que permite el estado actual (evita, por ejemplo, confirmar un pedido cancelado).
    await updateOrder(db, order, chosen.patch);
    return Astro.redirect(`${self}?ok=${chosen.action}`);
  } else {
    return Astro.redirect(self);
  }
}

const [items, events] = await Promise.all([listOrderItems(db, order.id), listOrderEvents(db, order.id)]);
const productIds = [...new Set(items.flatMap((i) => (i.productId ? [i.productId] : [])))];
const products = new Map((await listProductsByIds(db, store.id, productIds)).map((p) => [p.id, p]));
// Antes de confirmar: avisa si el stock de hoy no alcanza (al confirmar se descuenta lo que haya).
const shortages =
  order.status === 'new'
    ? items.flatMap((item) => {
        const product = item.productId ? products.get(item.productId) : undefined;
        if (!product) return [];
        const variant = item.variantId ? product.variants.find((v) => v.id === item.variantId) : undefined;
        if (item.variantId && !variant) return [];
        const units = availableUnits(product, variant);
        if (units === null || units >= item.quantity) return [];
        const label = item.variantName ? `${item.name} (${item.variantName})` : item.name;
        return [`De «${label}» ${units <= 0 ? 'no queda stock' : `quedan ${units}`} y el pedido lleva ${item.quantity}.`];
      })
    : [];
const steps = orderTimeline(order, events);
const config = checkoutConfig(store.settings);
const ok = MESSAGES[Astro.url.searchParams.get('ok') ?? ''] ?? null;
const okAction = Astro.url.searchParams.get('ok') ?? '';
const receipt = `${self}/comprobante`;
const isPdf = order.receiptType === 'application/pdf';
const publicUrl = (await storeLinker(db, store, Astro.url))(`/pedido/${order.token}`);
// El botón de WhatsApp lleva el mensaje del estado actual, listo para mandar.
const chat = customerChatUrl(order, customerUpdateMessage(order, store.name, publicUrl));
// Tras rechazar un comprobante el pedido sigue «Recibido», pero igual hay que contarle a la clienta.
const notify = NOTIFY_AFTER.has(okAction) && (order.status !== 'new' || okAction === 'reject_receipt');
const shippingStep = order.status === 'preparing';
const hasShipping = order.status === 'shipped' || order.status === 'delivered';
---

<AdminLayout title={`Pedido ${orderCode(order)} · ${store.name}`} current={store.slug} section="pedidos">
  <a class="back muted" href={base}>← Pedidos</a>
  <div class="row between">
    <div class="stack">
      <h1>Pedido {orderCode(order)}</h1>
      <p class="muted">Hecho el {formatDateTime(order.createdAt)} · {paymentMethodLabel(order, config)}</p>
    </div>
    <div class="tags">
      <span class:list={['tag', order.status]}>{ORDER_STATUS_LABELS[order.status]}</span>
      {
        order.status !== 'cancelled' && (order.paymentMethod === 'transfer' || order.paymentStatus === 'paid') && (
          <span class:list={['tag', `pay-${order.paymentStatus}`]}>{PAYMENT_STATUS_LABELS[order.paymentStatus]}</span>
        )
      }
    </div>
  </div>
  {
    ok && (
      <div class="alert ok notice" role="status">
        <span>{ok}</span>
        {notify && (
          <a class="button" href={chat} target="_blank" rel="noopener">
            Avisarle a {order.customerName.split(' ')[0]} por WhatsApp
          </a>
        )}
      </div>
    )
  }
  <Errors errors={errors} />

  <section class="card">
    <h2>Seguimiento</h2>
    <ol class="timeline">
      {
        steps.map((step) => (
          <li class:list={{ done: step.done, current: step.current, cancelled: step.status === 'cancelled' }}>
            <span class="dot" aria-hidden="true">{step.status === 'cancelled' ? '×' : step.done ? '✓' : ''}</span>
            <strong>{step.label}</strong>
            <small class="muted">{step.at ? formatDateTime(step.at) : step.done ? '' : 'Pendiente'}</small>
          </li>
        ))
      }
    </ol>
    {order.status === 'delivered' && <p class="muted">Pedido terminado.</p>}
  </section>

  <section class="card">
    <h2>Acciones</h2>
    {
      shortages.length > 0 && (
        <div class="alert warn" role="note">
          <strong>El stock no alcanza.</strong>
          <ul>
            {shortages.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
          <span>Al confirmar se descuenta lo que haya. Revisa si puedes hacer las unidades que faltan antes de confirmar.</span>
        </div>
      )
    }
    <form method="post" class="stack">
      {
        shippingStep && (
          <fieldset class="ship">
            <legend>Datos del envío</legend>
            <label class="field">
              <span>Transportadora</span>
              <input name="carrier" list="carriers" maxlength={CARRIER_MAX} value={shipping.carrier} autocomplete="off" />
            </label>
            <label class="field">
              <span>Número de guía <small class="muted">(opcional)</small></span>
              <input name="trackingNumber" maxlength={TRACKING_MAX} value={shipping.trackingNumber} autocomplete="off" />
            </label>
            <small class="muted">Se piden al marcar «En camino» y la clienta los ve en la página de su pedido.</small>
          </fieldset>
        )
      }
      <div class="row">
      {
        actions.map((a, i) => (
          <button
            class:list={['button', { secondary: i > 0 || a.action === 'reopen', danger: a.action === 'cancel' }]}
            name="action"
            value={a.action}
            data-confirm={a.confirm}
          >
            {a.label}
          </button>
        ))
      }
      <a class="button secondary" href={chat} target="_blank" rel="noopener">Escribirle por WhatsApp</a>
      </div>
    </form>
    {
      order.paymentMethod === 'transfer' && order.paymentStatus === 'review' && (
        <p class="muted">Revisa en tu banco que el dinero llegó antes de confirmar el pago.</p>
      )
    }
  </section>

  {
    hasShipping && (
      <form method="post" class="card">
        <h2>Envío</h2>
        <div class="ship">
          <label class="field">
            <span>Transportadora</span>
            <input name="carrier" list="carriers" maxlength={CARRIER_MAX} value={shipping.carrier} autocomplete="off" required />
          </label>
          <label class="field">
            <span>Número de guía <small class="muted">(opcional)</small></span>
            <input name="trackingNumber" maxlength={TRACKING_MAX} value={shipping.trackingNumber} autocomplete="off" />
          </label>
        </div>
        <div class="row">
          <button class="button secondary" name="action" value="shipping">Guardar datos del envío</button>
        </div>
      </form>
    )
  }

  {
    order.paymentMethod === 'transfer' && (
      <section class="card">
        <h2>Comprobante</h2>
        {order.receiptKey ? (
          <>
            <p class="muted">Subido el {formatDateTime(order.receiptAt!)}</p>
            {/* Sin JavaScript, el enlace abre el comprobante en otra pestaña; con JavaScript, en el visor. */}
            {isPdf ? (
              <a class="button secondary" href={receipt} target="_blank" rel="noopener" data-open-receipt>
                Ver PDF
              </a>
            ) : (
              <a href={receipt} target="_blank" rel="noopener" class="receipt" data-open-receipt title="Ver comprobante en grande">
                <img src={receipt} alt={`Comprobante del pedido ${orderCode(order)}`} />
              </a>
            )}
            <dialog class="viewer" id="receipt-viewer" aria-labelledby="receipt-viewer-title">
              <div class="viewer-bar">
                <strong id="receipt-viewer-title">Comprobante {orderCode(order)}</strong>
                <div class="viewer-actions">
                  <a class="button secondary" href={`${receipt}?descargar=1`} download>
                    Descargar
                  </a>
                  <a class="button secondary" href={receipt} target="_blank" rel="noopener">
                    Abrir en pestaña nueva ↗
                  </a>
                </div>
                <button class="viewer-close" type="button" data-close-receipt aria-label="Cerrar" title="Cerrar (Esc)" autofocus>
                  ×
                </button>
              </div>
              <div class="viewer-body">
                {isPdf ? (
                  <iframe data-src={receipt} title={`Comprobante del pedido ${orderCode(order)}`} />
                ) : (
                  <img src={receipt} alt={`Comprobante del pedido ${orderCode(order)}`} />
                )}
              </div>
            </dialog>
          </>
        ) : (
          <p class="muted">La clienta todavía no ha subido el comprobante.</p>
        )}
      </section>
    )
  }

  <div class="grid-2">
    <section class="card">
      <h2>Productos</h2>
      <ul class="items">
        {
          items.map((item) => (
            <li>
              <span class="thumb">{item.image ? <img src={item.image} alt="" loading="lazy" /> : null}</span>
              <span class="what">
                {item.productId ? (
                  <a href={`/admin/tiendas/${store.slug}/productos/${item.productId}`}>{item.name}</a>
                ) : (
                  item.name
                )}
                <small class="muted">
                  {item.variantName && `${item.variantName} · `}
                  {item.quantity} × {formatCOP(item.unitPrice)}
                </small>
                {order.stockApplied && item.stockTaken > 0 && (
                  <small class:list={['muted', { short: item.stockTaken < item.quantity }]}>
                    {`${item.stockTaken < item.quantity ? 'Solo se ' : 'Se '}${item.stockTaken === 1 ? 'descontó 1 unidad' : `descontaron ${item.stockTaken} unidades`} del stock${item.stockTaken < item.quantity ? ' (no alcanzó)' : ''}.`}
                  </small>
                )}
              </span>
              <span>{formatCOP(item.unitPrice * item.quantity)}</span>
            </li>
          ))
        }
      </ul>
      <dl class="totals">
        <dt>Subtotal</dt>
        <dd>{formatCOP(order.subtotal)}</dd>
        <dt>Envío ({order.shippingZone})</dt>
        <dd>{shippingLabel(order.shippingCost)}</dd>
        <dt>Total</dt>
        <dd><strong>{formatCOP(order.total)}</strong></dd>
      </dl>
    </section>

    <section class="card">
      <h2>Entrega</h2>
      <dl class="data">
        <dt>Nombre</dt>
        <dd>{order.customerName}</dd>
        <dt>Celular</dt>
        <dd><a href={chat} target="_blank" rel="noopener">{formatPhone(order.phone)}</a></dd>
        {
          order.email && (
            <>
              <dt>Correo</dt>
              <dd><a href={`mailto:${order.email}`}>{order.email}</a></dd>
            </>
          )
        }
        <dt>Dirección</dt>
        <dd>{order.address}<br />{order.city}, {order.department}</dd>
        {
          order.notes && (
            <>
              <dt>Notas de la clienta</dt>
              <dd class="pre">{order.notes}</dd>
            </>
          )
        }
      </dl>
      <a class="button link" href={publicUrl} target="_blank" rel="noopener">Ver la página del pedido que ve la clienta ↗</a>
    </section>
  </div>

  <form method="post" class="card">
    <h2>Nota interna</h2>
    <label class="field">
      <span class="visually-hidden">Nota interna</span>
      <textarea name="adminNote" maxlength="2000" placeholder="Solo la ves tú: acuerdos con la clienta, detalles de la personalización…">{order.adminNote}</textarea>
    </label>
    <div class="row">
      <button class="button secondary" name="action" value="note">Guardar nota</button>
    </div>
  </form>
  <datalist id="carriers">
    {CARRIERS.map((c) => <option value={c} />)}
  </datalist>
</AdminLayout>

<script>
  // Visor del comprobante: se cierra con «Cerrar», con Esc o tocando fuera de él.
  type Viewer = HTMLElement & { showModal(): void; close(): void; open: boolean };
  const viewer = document.getElementById('receipt-viewer') as Viewer | null;
  if (viewer) {
    document.querySelectorAll<HTMLAnchorElement>('[data-open-receipt]').forEach((link) =>
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return; // abrir en otra pestaña a propósito
        event.preventDefault();
        // El PDF se carga solo cuando se abre el visor.
        const frame = viewer.querySelector<HTMLIFrameElement>('iframe[data-src]');
        if (frame && !frame.src) frame.src = frame.dataset.src!;
        viewer.showModal();
      }),
    );
    viewer.querySelector('[data-close-receipt]')?.addEventListener('click', () => viewer.close());
    // El visor no tiene relleno propio: un clic cuyo destino es el <dialog> cayó en el fondo oscuro.
    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((button) =>
    button.addEventListener('click', (event) => {
      if (!confirm(button.dataset.confirm!)) event.preventDefault();
    }),
  );
</script>

<style>
  .back {
    text-decoration: none;
    font-size: 14px;
  }
  .between {
    justify-content: space-between;
    align-items: flex-start;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--a-bg);
    color: var(--a-muted);
    font-size: 13px;
  }
  .tag.new {
    background: var(--a-accent);
    color: var(--a-accent-ink);
  }
  .tag.confirmed,
  .tag.preparing,
  .tag.shipped,
  .tag.pay-review {
    background: var(--a-info-bg);
    color: var(--a-info);
  }
  .tag.delivered,
  .tag.pay-paid {
    background: var(--a-ok-bg);
    color: var(--a-ok);
  }
  .tag.pay-rejected {
    background: var(--a-err-bg);
    color: var(--a-err);
  }
  .timeline {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    column-gap: 10px;
    align-items: center;
  }
  .timeline small {
    grid-column: 2;
  }
  .timeline li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 28px;
    left: 12px;
    width: 2px;
    height: calc(100% - 14px);
    background: var(--a-line);
  }
  .timeline li.done:not(:last-child)::after {
    background: var(--a-ok);
  }
  .timeline .dot {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--a-line);
    border-radius: 50%;
    background: var(--a-panel);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .timeline .done .dot {
    border-color: var(--a-ok);
    background: var(--a-ok);
  }
  .timeline .current .dot {
    border-color: var(--a-accent);
    background: var(--a-accent);
    box-shadow: 0 0 0 4px var(--a-info-bg);
  }
  .timeline .cancelled .dot {
    border-color: var(--a-err);
    background: var(--a-err);
  }
  .timeline li:not(.done) strong {
    color: var(--a-muted);
    font-weight: 500;
  }
  /* En pantallas anchas, la línea de tiempo va de lado a lado. */
  @media (min-width: 720px) {
    .timeline {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 0;
    }
    .timeline li {
      grid-template-columns: none;
      justify-items: center;
      row-gap: 6px;
      text-align: center;
    }
    .timeline small {
      grid-column: auto;
    }
    .timeline li:not(:last-child)::after {
      top: 12px;
      left: calc(50% + 17px);
      width: calc(100% - 34px);
      height: 2px;
    }
  }
  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .ship {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .ship legend {
    margin-bottom: 4px;
    font-weight: 600;
  }
  @media (min-width: 720px) {
    .ship {
      grid-template-columns: 1fr 1fr;
    }
    .ship legend,
    .ship > small {
      grid-column: 1 / -1;
    }
  }
  .short {
    color: var(--a-err);
  }
  .button.danger {
    border-color: var(--a-err);
    color: var(--a-err);
  }
  .receipt {
    display: inline-block;
    cursor: zoom-in;
  }
  .viewer {
    width: min(96vw, 1100px);
    max-width: none;
    height: min(94dvh, 1400px);
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: var(--a-radius);
    background: var(--a-panel);
    color: var(--a-ink);
  }
  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  :global(body:has(.viewer[open])) {
    overflow: hidden;
  }
  .viewer-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'title close' 'actions actions';
    align-items: center;
    gap: 10px;
    padding: 10px 12px 12px 14px;
    border-bottom: 1px solid var(--a-line);
  }
  .viewer-bar strong {
    grid-area: title;
  }
  .viewer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    grid-area: actions;
  }
  .viewer-actions .button {
    padding: 6px 12px;
    font-size: 14px;
  }
  .viewer-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--a-line);
    border-radius: 50%;
    background: var(--a-panel);
    color: var(--a-ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    grid-area: close;
  }
  .viewer-close:hover {
    background: var(--a-bg);
  }
  @media (min-width: 720px) {
    .viewer-bar {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'title actions close';
      padding-bottom: 10px;
    }
  }
  /* El comprobante se ve completo, ajustado al visor (suelen ser capturas altas del celular). */
  .viewer-body {
    position: relative;
    min-height: 0;
    background: var(--a-bg);
  }
  .viewer-body img,
  .viewer-body iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .viewer-body img {
    padding: 12px;
    object-fit: contain;
  }
  .receipt img {
    max-width: min(100%, 420px);
    max-height: 600px;
    border: 1px solid var(--a-line);
    border-radius: 8px;
  }
  .items {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  .thumb {
    width: 44px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: var(--a-bg);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .what {
    display: grid;
  }
  .totals,
  .data {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
  }
  .totals {
    padding-top: 12px;
    border-top: 1px solid var(--a-line);
  }
  .totals dd {
    text-align: right;
  }
  dt {
    color: var(--a-muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .pre {
    white-space: pre-line;
  }
  .visually-hidden {
