---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Errors from '../../../../components/admin/Errors.astro';
import { getDb } from '../../../../lib/db';
import { getDomains, getStoreBySlug, parseDomains, setDomains, updateGeneral } from '../../../../modules/tiendas/repo';
import {
  MAX_SHIPPING_ZONES,
  PAYMENT_OPTIONS,
  checkoutConfig,
  validateSettings,
  type NavLink,
  type ShippingZone,
} from '../../../../modules/tiendas/settings';
import { parsePrice } from '../../../../modules/catalogo/validate';
import { formatCOP } from '../../../../modules/catalogo/format';

const db = getDb();
const store = await getStoreBySlug(db, Astro.params.slug!);
if (!store) return new Response(null, { status: 404 });

const NAV_ROWS = 5;
let errors: string[] = [];
// Filas del formulario de envíos: el costo se muestra como texto para poder corregirlo tal cual se escribió.
type ZoneRow = { name: string; price: string; cod: boolean };
const zoneRows = (zones: ShippingZone[] = []): ZoneRow[] =>
  zones.map((z) => ({ name: z.name, price: z.price === null ? '' : formatCOP(z.price), cod: z.cod }));
const saved = store.settings.shippingZones?.length ? checkoutConfig(store.settings) : null;
let zoneValues = zoneRows(saved?.zones);
let freeShippingText = saved?.freeShippingFrom ? formatCOP(saved.freeShippingFrom) : '';
let values = {
  name: store.name,
  tagline: store.tagline,
  description: store.description,
  settings: store.settings,
  domains: (await getDomains(db, store.id))
    .sort((a, b) => Number(b.isPrimary) - Number(a.isPrimary))
    .map((d) => d.hostname)
    .join('\n'),
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (key: string) => String(form.get(key) ?? '').trim();
  const nav: NavLink[] = Array.from({ length: NAV_ROWS }, (_, i) => ({
    label: text(`nav.${i}.label`),
    href: text(`nav.${i}.href`),
  }));
  zoneValues = Array.from({ length: MAX_SHIPPING_ZONES }, (_, i) => ({
    name: text(`zone.${i}.name`),
    price: text(`zone.${i}.price`),
    cod: form.get(`zone.${i}.cod`) === 'on',
  })).filter((z) => z.name || z.price);
  freeShippingText = text('freeShippingFrom');
  const settingsResult = validateSettings({
    whatsapp: text('whatsapp'),
    whatsappMessage: text('whatsappMessage'),
    instagram: text('instagram'),
    payments: form.getAll('payments').map(String),
    nav,
    legalNotice: text('legalNotice'),
    footerNote: text('footerNote'),
    transferInstructions: text('transferInstructions'),
    shippingZones: zoneValues.map((z) => ({ name: z.name, price: parsePrice(z.price), cod: z.cod })),
    freeShippingFrom: parsePrice(freeShippingText),
  });
  const domainResult = parseDomains(text('domains'));

  values = {
    name: text('name'),
    tagline: text('tagline'),
    description: text('description'),
    settings: settingsResult.ok
      ? settingsResult.settings
      : {
          ...store.settings,
          whatsapp: text('whatsapp'),
          whatsappMessage: text('whatsappMessage'),
          instagram: text('instagram'),
          payments: form.getAll('payments').map(String),
          nav: nav.filter((l) => l.label || l.href),
          legalNotice: text('legalNotice'),
          footerNote: text('footerNote'),
          transferInstructions: text('transferInstructions'),
        },
    domains: text('domains'),
  };

  if (!values.name) errors.push('El nombre de la tienda es obligatorio.');
  if (values.description.length > 300) errors.push('La descripción para buscadores debe tener máximo 300 caracteres.');
  if (!settingsResult.ok) errors.push(...settingsResult.errors);
  errors.push(...domainResult.errors);

  if (!errors.length && settingsResult.ok) {
    errors = await setDomains(db, store.id, domainResult.hostnames);
    if (!errors.length) {
      await updateGeneral(db, store.id, {
        name: values.name,
        tagline: values.tagline,
        description: values.description,
        settings: settingsResult.settings,
      });
      return Astro.redirect(`/admin/tiendas/${store.slug}?guardado=1`);
    }
  }
}

const ok = Astro.url.searchParams.has('guardado') ? 'Cambios guardados. Ya se ven en la tienda.' : null;
const zoneFormRows = Array.from({ length: MAX_SHIPPING_ZONES }, (_, i) => zoneValues[i] ?? { name: '', price: '', cod: false });
const navRows = Array.from({ length: NAV_ROWS }, (_, i) => values.settings.nav[i] ?? { label: '', href: '' });
---

<AdminLayout title={`Ajustes de ${store.name}`} current={store.slug} section="general">
  <div class="stack">
    <h1>Ajustes generales</h1>
    <p class="muted">Nombre, contacto, métodos de pago y textos fijos de {store.name}.</p>
  </div>
  <Errors errors={errors} ok={ok} />

  <form method="post" class="stack">
    <section class="card">
      <h2>Identidad</h2>
      <label class="field">
        <span>Nombre de la tienda</span>
        <input type="text" name="name" value={values.name} required maxlength="80" />
      </label>
      <label class="field">
        <span>Frase corta</span>
        <input type="text" name="tagline" value={values.tagline} maxlength="120" />
        <small>Aparece en el título de la pestaña y en el footer.</small>
      </label>
      <label class="field">
        <span>Descripción para buscadores y redes</span>
        <textarea name="description" maxlength="300">{values.description}</textarea>
        <small>Máximo 300 caracteres. Es el texto que muestran Google y WhatsApp al compartir el enlace.</small>
      </label>
    </section>

    <section class="card">
      <h2>Contacto</h2>
      <div class="grid-2">
        <label class="field">
          <span>WhatsApp</span>
          <input type="text" name="whatsapp" value={values.settings.whatsapp} inputmode="numeric" required />
          <small>Con indicativo de país y sin espacios, ej. 573001234567.</small>
        </label>
        <label class="field">
          <span>Instagram</span>
          <input type="text" name="instagram" value={values.settings.instagram} />
          <small>Solo el usuario, sin @. Déjalo vacío si aún no hay cuenta.</small>
        </label>
      </div>
      <label class="field">
        <span>Mensaje inicial de WhatsApp</span>
        <input type="text" name="whatsappMessage" value={values.settings.whatsappMessage} maxlength="200" />
        <small>Texto que aparece escrito cuando alguien toca un botón de WhatsApp.</small>
      </label>
    </section>

    <section class="card">
      <h2>Métodos de pago</h2>
      <div class="row">
        {
          PAYMENT_OPTIONS.map((p) => (
            <label class="check">
              <input type="checkbox" name="payments" value={p} checked={values.settings.payments.includes(p)} />
              {p}
            </label>
          ))
        }
      </div>
      <small class="muted">Se muestran en la sección «Cómo comprar» y al finalizar la compra. La pasarela en línea llegará en una fase posterior.</small>
      <label class="field">
        <span>Datos para Bre-B o transferencia</span>
        <textarea name="transferInstructions" maxlength="1000" placeholder="Llave Bre-B: @artelicat&#10;Bancolombia ahorros 000-000000-00&#10;A nombre de …">{values.settings.transferInstructions ?? ''}</textarea>
        <small>Se muestran a la clienta después de confirmar su pedido, junto con el valor a pagar. Si lo dejas vacío, le decimos que se los envías por WhatsApp.</small>
      </label>
    </section>

    <section class="card">
      <h2>Envíos</h2>
      <p class="muted">
        Destinos que la clienta elige al finalizar la compra. Deja el costo vacío para confirmarlo por WhatsApp. El pago contra
        entrega solo aparece en los destinos marcados.
      </p>
      <div class="zones">
        <span class="zone-head">Destino</span>
        <span class="zone-head">Costo</span>
        <span class="zone-head">Contra entrega</span>
        {
          zoneFormRows.map((z, i) => (
            <>
              <input type="text" name={`zone.${i}.name`} value={z.name} maxlength="60" aria-label={`Destino ${i + 1}`} placeholder={i === 0 ? 'Bogotá' : i === 1 ? 'Resto del país' : ''} />
              <input type="text" name={`zone.${i}.price`} value={z.price} inputmode="numeric" aria-label={`Costo del destino ${i + 1}`} placeholder={i === 0 ? '8.000' : ''} />
              <label class="check">
                <input type="checkbox" name={`zone.${i}.cod`} checked={z.cod} />
                <span class="cod-label">Sí</span>
              </label>
            </>
          ))
        }
      </div>
      <label class="field">
        <span>Envío gratis desde</span>
        <input type="text" name="freeShippingFrom" value={freeShippingText} inputmode="numeric" placeholder="Ej. 150.000" />
        <small>Subtotal a partir del cual el envío no se cobra en ningún destino. Déjalo vacío si no aplica.</small>
      </label>
      {!saved && <small class="muted">Mientras no guardes destinos, la tienda muestra «Envío a todo Colombia» con costo por confirmar y sin contra entrega.</small>}
    </section>

    <section class="card">
      <h2>Menú superior</h2>
      <p class="muted">Usa #seccion para saltar a una parte de la página de inicio, /ruta o una dirección https://.</p>
      {
        navRows.map((l, i) => (
          <div class="grid-2">
            <label class="field">
              <span>Texto {i + 1}</span>
              <input type="text" name={`nav.${i}.label`} value={l.label} maxlength="30" />
            </label>
            <label class="field">
              <span>Enlace {i + 1}</span>
              <input type="text" name={`nav.${i}.href`} value={l.href} />
            </label>
          </div>
        ))
      }
    </section>

    <section class="card">
      <h2>Footer</h2>
      <label class="field">
        <span>Aviso legal</span>
        <textarea name="legalNotice">{values.settings.legalNotice}</textarea>
        <small>Recomendado: aclarar que la tienda es independiente y no está afiliada a las marcas que la inspiran.</small>
      </label>
      <label class="field">
        <span>Nota final</span>
        <input type="text" name="footerNote" value={values.settings.footerNote} maxlength="80" />
      </label>
    </section>

    <section class="card">
      <h2>Dominios</h2>
      <label class="field">
        <span>Dominios de esta tienda</span>
        <textarea name="domains" placeholder="artelicat.com&#10;www.artelicat.com">{values.domains}</textarea>
        <small>
          Uno por línea; el primero es el principal. Mientras no tengas dominio propio puedes dejarlo vacío: cada tienda
          responde en su propio subdominio gratuito de Cloudflare.
        </small>
      </label>
    </section>

    <div class="row">
      <button class="button" type="submit">Guardar cambios</button>
      <a class="button link" href={`/?tienda=${store.slug}`} target="_blank" rel="noopener">Ver tienda ↗</a>
    </div>
  </form>
</AdminLayout>

<style>
  .zones {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 12px;
  }
  .zone-head {
    font-weight: 600;
    font-size: 14px;
  }
  @media (max-width: 559px) {
    .cod-label {
      display: none;
    }
  }
</style>
